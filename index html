<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <title>SEUR · Instant Refund & Compensation</title>
  <!-- Font Awesome Icons (v6 free) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    /* ---------- RESET & GLOBAL ---------- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Roboto, system-ui, -apple-system, sans-serif;
    }

    body {
      background: linear-gradient(145deg, #f0f4fa 0%, #e6ecf5 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1.5rem;
    }

    /* ----- MAIN CARD ----- */
    .refund-card {
      max-width: 900px;
      width: 100%;
      background: #ffffff;
      border-radius: 2.5rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), 0 4px 10px rgba(0, 0, 0, 0.05);
      overflow: hidden;
      transition: all 0.2s ease;
      border: 1px solid rgba(255, 255, 255, 0.5);
    }

    /* ----- HEADER with SEUR delivery guy + van logo (pure CSS/SVG) ----- */
    .seur-header {
      background: #0b2b4b;
      background: linear-gradient(135deg, #0b2b4b 0%, #123e6b 100%);
      padding: 1.25rem 2rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      border-bottom: 5px solid #ffc107;
    }

    .logo-delivery {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .van-icon {
      position: relative;
      width: 70px;
      height: 44px;
      background: transparent;
      display: flex;
      align-items: center;
    }

    /* Van + driver graphic made with SVG (clean & scalable) */
    .van-svg {
      width: 100%;
      height: auto;
      filter: drop-shadow(0 4px 4px rgba(0, 0, 0, 0.2));
    }

    .seur-text {
      font-weight: 700;
      font-size: 1.9rem;
      letter-spacing: 1px;
      color: white;
      line-height: 1;
      text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.15);
    }

    .seur-text span {
      color: #ffc107;
      font-weight: 800;
    }

    .header-tagline {
      margin-left: auto;
      color: #cddcee;
      font-size: 0.9rem;
      font-weight: 500;
      background: rgba(255, 255, 255, 0.08);
      padding: 0.45rem 1rem;
      border-radius: 40px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      white-space: nowrap;
    }

    /* ----- FORM BODY ----- */
    .form-body {
      padding: 2rem 2rem 2.25rem;
    }

    .section-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: #0b2b4b;
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.65rem;
      border-left: 5px solid #ffc107;
      padding-left: 1rem;
      letter-spacing: -0.2px;
    }

    .section-title i {
      color: #ffc107;
      font-size: 1.3rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.2rem 1.5rem;
      margin-bottom: 2rem;
    }

    .form-grid .full-width {
      grid-column: 1 / -1;
    }

    .input-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .input-group label {
      font-size: 0.85rem;
      font-weight: 600;
      color: #2c3e50;
      letter-spacing: 0.3px;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .input-group label i {
      color: #ffc107;
      font-size: 0.8rem;
      width: 16px;
    }

    .input-group input,
    .input-group textarea,
    .input-group select {
      padding: 0.85rem 1rem;
      border: 1.5px solid #dfe7f1;
      border-radius: 18px;
      font-size: 0.95rem;
      background: #fafcff;
      transition: all 0.2s;
      outline: none;
      color: #0b2b4b;
      font-weight: 500;
    }

    .input-group input:focus,
    .input-group textarea:focus {
      border-color: #ffc107;
      box-shadow: 0 0 0 4px rgba(255, 193, 7, 0.15);
      background: #ffffff;
    }

    .input-group textarea {
      resize: vertical;
      min-height: 80px;
    }

    .input-group input::placeholder,
    .input-group textarea::placeholder {
      color: #9aaebf;
      font-weight: 400;
    }

    /* payment modal style — we make it a card section, not overlay */
    .payment-section {
      background: #f9fcff;
      border-radius: 2rem;
      padding: 1.5rem 1.5rem 1.75rem;
      border: 1.5px dashed #cddcee;
      margin-top: 0.5rem;
      margin-bottom: 1.8rem;
      box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.02);
    }

    .payment-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: #0b2b4b;
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .payment-title i {
      background: #ffc107;
      color: #0b2b4b;
      padding: 0.4rem;
      border-radius: 12px;
      font-size: 1rem;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem 1.25rem;
    }

    .card-grid .card-full {
      grid-column: 1 / -1;
    }

    /* optional feedback */
    .feedback-optional {
      background: #ffffff;
      border-radius: 1.5rem;
      padding: 1.25rem 1.5rem;
      margin: 1rem 0 1.5rem;
      border: 1px solid #e2eaf3;
    }

    .feedback-optional label {
      font-weight: 600;
      color: #2c3e50;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 0.6rem;
    }

    .feedback-optional textarea {
      width: 100%;
      padding: 0.85rem 1rem;
      border: 1.5px solid #dfe7f1;
      border-radius: 18px;
      font-size: 0.95rem;
      background: #fafcff;
      resize: vertical;
      min-height: 70px;
    }

    .feedback-optional textarea:focus {
      border-color: #ffc107;
      box-shadow: 0 0 0 4px rgba(255, 193, 7, 0.12);
      outline: none;
    }

    /* button */
    .submit-btn {
      background: #0b2b4b;
      color: white;
      border: none;
      padding: 1.1rem 2rem;
      font-size: 1.15rem;
      font-weight: 700;
      border-radius: 50px;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      cursor: pointer;
      transition: all 0.2s;
      letter-spacing: 0.5px;
      box-shadow: 0 10px 18px -8px #0b2b4b80;
      border-bottom: 3px solid #ffc107;
    }

    .submit-btn:hover {
      background: #123e6b;
      transform: scale(1.01);
    }

    .submit-btn:active {
      transform: scale(0.98);
    }

    /* review section (saved entries) */
    .review-section {
      margin-top: 2.5rem;
      border-top: 2px solid #e2eaf3;
      padding-top: 1.8rem;
    }

    .review-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: 1.2rem;
    }

    .review-header h3 {
      color: #0b2b4b;
      font-size: 1.2rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .review-header h3 i {
      color: #ffc107;
    }

    .clear-btn {
      background: transparent;
      border: 1.5px solid #cddcee;
      padding: 0.4rem 1.2rem;
      border-radius: 40px;
      color: #5b7a9a;
      font-weight: 600;
      font-size: 0.8rem;
      cursor: pointer;
      transition: 0.2s;
    }

    .clear-btn:hover {
      background: #fee2e2;
      border-color: #e46060;
      color: #b91c1c;
    }

    .entries-list {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      max-height: 400px;
      overflow-y: auto;
      padding-right: 5px;
    }

    .entry-card {
      background: #f6faff;
      border-radius: 1.2rem;
      padding: 1rem 1.25rem;
      border-left: 6px solid #ffc107;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
      font-size: 0.9rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      border: 1px solid #e2eaf3;
    }

    .entry-info {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem 1.5rem;
      color: #1e3a5f;
    }

    .entry-info strong {
      color: #0b2b4b;
      font-weight: 700;
    }

    .entry-info .badge {
      background: #ffc10720;
      padding: 0.2rem 0.8rem;
      border-radius: 30px;
      font-size: 0.75rem;
      font-weight: 600;
      color: #b57f00;
    }

    .entry-amount {
      font-weight: 800;
      color: #0b2b4b;
      background: #ffc10720;
      padding: 0.3rem 1rem;
      border-radius: 40px;
      font-size: 0.95rem;
    }

    .entry-delete {
      background: none;
      border: none;
      color: #b91c1c;
      font-size: 1.1rem;
      cursor: pointer;
      padding: 0.2rem 0.6rem;
      border-radius: 20px;
      transition: 0.1s;
    }

    .entry-delete:hover {
      background: #ffe5e5;
    }

    .empty-msg {
      color: #8da3ba;
      font-style: italic;
      padding: 1rem 0;
      text-align: center;
    }

    /* Responsive */
    @media (max-width: 600px) {
      body {
        padding: 0.8rem;
      }
      .form-body {
        padding: 1.5rem 1rem;
      }
      .seur-header {
        padding: 1rem 1.2rem;
      }
      .seur-text {
        font-size: 1.5rem;
      }
      .header-tagline {
        font-size: 0.7rem;
        white-space: normal;
        margin-left: 0;
      }
      .section-title {
        font-size: 1.1rem;
      }
      .submit-btn {
        font-size: 1rem;
      }
    }

    @media (max-width: 400px) {
      .van-icon {
        width: 55px;
      }
      .seur-text {
        font-size: 1.25rem;
      }
    }
  </style>
</head>
<body>
  <div class="refund-card">
    <!-- SEUR LOGO: delivery guy with van (SVG) + brand text -->
    <div class="seur-header">
      <div class="logo-delivery">
        <div class="van-icon">
          <!-- Delivery guy with van – pure SVG -->
          <svg class="van-svg" viewBox="0 0 100 60" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- van body -->
            <rect x="8" y="20" width="55" height="26" rx="7" fill="#FFC107" stroke="#0B2B4B" stroke-width="2.5"/>
            <!-- windshield -->
            <path d="M32 22 L44 22 L48 33 L32 33 Z" fill="#A0C4E8" stroke="#0B2B4B" stroke-width="2"/>
            <!-- delivery guy (driver silhouette) -->
            <circle cx="20" cy="16" r="5.5" fill="#0B2B4B" stroke="#FFFFFF" stroke-width="2"/>
            <!-- cap peak -->
            <rect x="16" y="11" width="10" height="4" rx="2" fill="#0B2B4B" stroke="#FFFFFF" stroke-width="1.2"/>
            <!-- body -->
            <rect x="16" y="22" width="7" height="14" rx="2.5" fill="#0B2B4B" stroke="#FFFFFF" stroke-width="1.8"/>
            <!-- arms holding wheel (optional) -->
            <line x1="21" y1="26" x2="27" y2="30" stroke="#0B2B4B" stroke-width="2.5" stroke-linecap="round"/>
            <!-- wheels -->
            <circle cx="20" cy="46" r="7" fill="#2C3E50" stroke="#1E2F40" stroke-width="2.5" />
            <circle cx="20" cy="46" r="3.5" fill="#A0B8D0" />
            <circle cx="50" cy="46" r="7" fill="#2C3E50" stroke="#1E2F40" stroke-width="2.5" />
            <circle cx="50" cy="46" r="3.5" fill="#A0B8D0" />
            <!-- back box -->
            <rect x="56" y="25" width="12" height="16" rx="3" fill="#FFC107" stroke="#0B2B4B" stroke-width="2" />
            <text x="61" y="37" font-family="Arial" font-size="10" font-weight="bold" fill="#0B2B4B">SEUR</text>
            <!-- text on van -->
            <text x="30" y="44" font-family="Arial" font-size="8" font-weight="bold" fill="#0B2B4B" letter-spacing="1">SEUR</text>
          </svg>
        </div>
        <div class="seur-text">SEUR<span>.</span></div>
      </div>
      <div class="header-tagline"><i class="fas fa-bolt" style="color:#ffc107;margin-right:5px;"></i>Instant refund · 24h</div>
    </div>

    <div class="form-body">
      <!-- MAIN FORM -->
      <form id="refundForm" novalidate>
        <!-- SECTION 1: claim information -->
        <div class="section-title"><i class="fas fa-user-circle"></i> Claimant & claim details</div>
        <div class="form-grid">
          <div class="input-group">
            <label><i class="fas fa-hashtag"></i> REFERENCE NUMBER</label>
            <input type="text" id="refNumber" placeholder="SEUR-12345-ES" required>
          </div>
          <div class="input-group">
            <label><i class="fas fa-user"></i> FULL NAMES</label>
            <input type="text" id="fullNames" placeholder="e.g. Ana García López" required>
          </div>
          <div class="input-group">
            <label><i class="fas fa-phone-alt"></i> PHONE NUMBER</label>
            <input type="tel" id="phone" placeholder="+34 612 345 678" required>
          </div>
          <div class="input-group">
            <label><i class="fas fa-envelope"></i> EMAIL ADDRESS</label>
            <input type="email" id="email" placeholder="ana@example.com" required>
          </div>
          <div class="input-group">
            <label><i class="fas fa-calendar-alt"></i> DATE OF BIRTH</label>
            <input type="date" id="dob" required>
          </div>
          <div class="input-group">
            <label><i class="fas fa-euro-sign"></i> CLAIM AMOUNT (€)</label>
            <input type="number" id="claimAmount" placeholder="120.00" step="0.01" min="0" required>
          </div>
          <div class="input-group full-width">
            <label><i class="fas fa-comment-dots"></i> DESCRIBE YOUR CLAIM</label>
            <textarea id="claimDescription" placeholder="Explain what happened with your delivery..." required></textarea>
          </div>
        </div>

        <!-- SECTION 2: RECEIVER'S DETAIL -->
        <div class="section-title"><i class="fas fa-map-pin"></i> Receiver's detail</div>
        <div class="form-grid">
          <div class="input-group">
            <label><i class="fas fa-globe"></i> COUNTRY</label>
            <input type="text" id="receiverCountry" placeholder="España" required>
          </div>
          <div class="input-group">
            <label><i class="fas fa-city"></i> CITY</label>
            <input type="text" id="receiverCity" placeholder="Madrid" required>
          </div>
          <div class="input-group full-width">
            <label><i class="fas fa-road"></i> STREET LINE ADDRESS</label>
            <input type="text" id="receiverStreet" placeholder="Calle Mayor, 123, 4ºB" required>
          </div>
          <div class="input-group">
            <label><i class="fas fa-mailbox"></i> POSTAL CODE</label>
            <input type="text" id="receiverPostal" placeholder="28013" required>
          </div>
        </div>

        <!-- SECTION 3: PAYMENT MODAL (card details) + optional feedback -->
        <div class="payment-section">
          <div class="payment-title"><i class="fas fa-credit-card"></i> Payment method (instant refund)</div>
          <div class="card-grid">
            <div class="input-group card-full">
              <label><i class="fas fa-user-tag"></i> CARDHOLDER'S NAME</label>
              <input type="text" id="cardholderName" placeholder="As shown on card" required>
            </div>
            <div class="input-group card-full">
              <label><i class="fas fa-credit-card"></i> CARD NUMBER</label>
              <input type="text" id="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19" required>
            </div>
            <div class="input-group">
              <label><i class="fas fa-calendar-week"></i> EXPIRY DATE</label>
              <input type="text" id="expiryDate" placeholder="MM/YY" maxlength="5" required>
            </div>
            <div class="input-group">
              <label><i class="fas fa-lock"></i> CVV</label>
              <input type="text" id="cvv" placeholder="123" maxlength="4" required>
            </div>
          </div>

          <!-- OPTIONAL FEEDBACK -->
          <div class="feedback-optional">
            <label><i class="fas fa-star" style="color:#ffc107;"></i> FEEDBACK (optional)</label>
            <textarea id="feedback" placeholder="Any additional comments? (optional)"></textarea>
          </div>
        </div>

        <button type="submit" class="submit-btn"><i class="fas fa-paper-plane"></i> Submit claim & request refund</button>
      </form>

      <!-- SAVED ENTRIES / REVIEW SECTION -->
      <div class="review-section">
        <div class="review-header">
          <h3><i class="fas fa-database"></i> Saved claims (review)</h3>
          <button class="clear-btn" id="clearAllBtn"><i class="fas fa-trash-alt"></i> Clear all</button>
        </div>
        <div id="entriesContainer" class="entries-list">
          <div class="empty-msg"><i class="fas fa-inbox"></i> No claims submitted yet.</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function() {
      // ----- DATA STORAGE (in-memory + localStorage) -----
      const STORAGE_KEY = 'seur_claims';
      let claims = [];

      // Load from localStorage on page load
      function loadClaims() {
        try {
          const stored = localStorage.getItem(STORAGE_KEY);
          if (stored) {
            claims = JSON.parse(stored);
          } else {
            claims = [];
          }
        } catch (e) {
          console.warn('Failed to load claims', e);
          claims = [];
        }
        renderClaims();
      }

      // Save to localStorage
      function saveClaims() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(claims));
        } catch (e) {
          console.warn('Could not save to localStorage', e);
        }
      }

      // ----- RENDER SAVED ENTRIES -----
      function renderClaims() {
        const container = document.getElementById('entriesContainer');
        if (!container) return;

        if (claims.length === 0) {
          container.innerHTML = `<div class="empty-msg"><i class="fas fa-inbox"></i> No claims submitted yet.</div>`;
          return;
        }

        let html = '';
        claims.forEach((claim, index) => {
          // Format date for display
          const claimDate = claim.submittedAt ? new Date(claim.submittedAt).toLocaleDateString('es-ES') : '—';
          // Show amount with 2 decimals
          const amount = typeof claim.claimAmount === 'number' ? claim.claimAmount.toFixed(2) : '0.00';

          html += `
            <div class="entry-card" data-index="${index}">
              <div class="entry-info">
                <span><strong>#${claim.refNumber || 'N/A'}</strong></span>
                <span>${claim.fullNames || 'No name'}</span>
                <span class="badge">${claim.receiverCity || '—'}, ${claim.receiverCountry || '—'}</span>
                <span>${claimDate}</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.8rem;">
                <span class="entry-amount">${amount} €</span>
                <button class="entry-delete" data-index="${index}" title="Delete entry"><i class="fas fa-times-circle"></i></button>
              </div>
            </div>
          `;
        });

        container.innerHTML = html;

        // Attach delete listeners to each delete button
        container.querySelectorAll('.entry-delete').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const idx = parseInt(btn.getAttribute('data-index'), 10);
            if (!isNaN(idx) && idx >= 0 && idx < claims.length) {
              claims.splice(idx, 1);
              saveClaims();
              renderClaims();
            }
          });
        });
      }

      // ----- FORM SUBMIT -----
      const form = document.getElementById('refundForm');
      form.addEventListener('submit', function(e) {
        e.preventDefault();

        // Gather all fields (we'll treat empty optional feedback as empty string)
        const refNumber = document.getElementById('refNumber').value.trim();
        const fullNames = document.getElementById('fullNames').value.trim();
        const phone = document.getElementById('phone').value.trim();
        const email = document.getElementById('email').value.trim();
        const dob = document.getElementById('dob').value;
        const claimAmountRaw = document.getElementById('claimAmount').value.trim();
        const claimDescription = document.getElementById('claimDescription').value.trim();

        const receiverCountry = document.getElementById('receiverCountry').value.trim();
        const receiverCity = document.getElementById('receiverCity').value.trim();
        const receiverStreet = document.getElementById('receiverStreet').value.trim();
        const receiverPostal = document.getElementById('receiverPostal').value.trim();

        const cardholderName = document.getElementById('cardholderName').value.trim();
        const cardNumber = document.getElementById('cardNumber').value.trim();
        const expiryDate = document.getElementById('expiryDate').value.trim();
        const cvv = document.getElementById('cvv').value.trim();
        const feedback = document.getElementById('feedback').value.trim();  // optional

        // Basic validation (just required fields)
        if (!refNumber || !fullNames || !phone || !email || !dob || !claimAmountRaw || !claimDescription ||
            !receiverCountry || !receiverCity || !receiverStreet || !receiverPostal ||
            !cardholderName || !cardNumber || !expiryDate || !cvv) {
          alert('Please fill in all required fields.');
          return;
        }

        const claimAmount = parseFloat(claimAmountRaw);
        if (isNaN(claimAmount) || claimAmount <= 0) {
          alert('Please enter a valid claim amount greater than 0.');
          return;
        }

        // Create claim object
        const newClaim = {
          id: Date.now() + '-' + Math.random().toString(36).substr(2, 6),
          refNumber,
          fullNames,
          phone,
          email,
          dob,
          claimAmount: claimAmount,
          claimDescription,
          receiverCountry,
          receiverCity,
          receiverStreet,
          receiverPostal,
          cardholderName,
          cardNumber: cardNumber.replace(/\s/g, ''), // store raw digits
          expiryDate,
          cvv: '***', // never store CVV in plain text! But we keep placeholder for demo (not saving actual CVV)
          feedback: feedback, // optional
          submittedAt: new Date().toISOString()
        };

        // Push to claims array
        claims.push(newClaim);
        saveClaims();
        renderClaims();

        // Reset form
        form.reset();

        // Show success message
        alert('✅ Claim submitted successfully! Your refund is being processed.');
      });

      // ----- CLEAR ALL BUTTON -----
      document.getElementById('clearAllBtn').addEventListener('click', function() {
        if (claims.length === 0) return;
        if (confirm('Are you sure you want to delete all saved claims? This cannot be undone.')) {
          claims = [];
          saveClaims();
          renderClaims();
        }
      });

      // ----- Initialize -----
      loadClaims();

      // Additional: card number formatting (space every 4 digits) for nicer UX
      const cardInput = document.getElementById('cardNumber');
      if (cardInput) {
        cardInput.addEventListener('input', function(e) {
          let value = this.value.replace(/\s/g, '').replace(/\D/g, '');
          let formatted = '';
          for (let i = 0; i < value.length; i++) {
            if (i > 0 && i % 4 === 0) formatted += ' ';
            formatted += value[i];
          }
          this.value = formatted.slice(0, 19); // 16 digits + 3 spaces
        });
      }

      // Expiry date formatting MM/YY
      const expiryInput = document.getElementById('expiryDate');
      if (expiryInput) {
        expiryInput.addEventListener('input', function(e) {
          let value = this.value.replace(/\D/g, '');
          if (value.length >= 2) {
            value = value.slice(0,2) + '/' + value.slice(2,4);
          }
          this.value = value.slice(0,5);
        });
      }
    })();
  </script>
</body>
</html>
